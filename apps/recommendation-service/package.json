{
  "name": "@eshop/recommendation-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nx serve recommendation-service"
  },
  "nx": {
    "name": "recommendation-service",
    "projectType": "application",
    "sourceRoot": "apps/recommendation-service/src",
    "targets": {
      "build": {
        "executor": "@nx/webpack:webpack",
        "defaultConfiguration": "development",
        "options": {
          "target": "node",
          "outputPath": "out-tsc/recommendation-service",
          "main": "apps/recommendation-service/src/main.ts",
          "tsConfig": "apps/recommendation-service/tsconfig.app.json",
          "webpackConfig": "apps/recommendation-service/webpack.config.js",
          "assets": [
            {
              "glob": "swagger-output.json",
              "input": "apps/recommendation-service/src",
              "output": "."
            }
          ]
        },
        "configurations": {
          "development": {
            "mode": "development"
          },
          "production": {
            "mode": "production"
          }
        }
      },
      "serve": {
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": ["build"],
        "options": {
          "buildTarget": "recommendation-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "recommendation-service:build:development"
          },
          "production": {
            "buildTarget": "recommendation-service:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  }
}